# Copy to .env and fill in. NEVER commit real keys.
RECALLWEAVE_APP_ENV=dev
# Postgres (pgvector) primary path; SQLite fallback works with zero extra deps:
# RECALLWEAVE_DB_URL=postgresql+asyncpg://recallweave:recallweave@localhost:5432/recallweave
RECALLWEAVE_DB_URL=sqlite+aiosqlite:///./data/recallweave.db

# Bearer tokens -> user ids (JSON map). Replace for real deployments.
RECALLWEAVE_API_KEYS_JSON={"dev-key-1":"11111111-1111-1111-1111-111111111111"}

# LLM: OpenAI-compatible endpoint (DeepSeek/Qwen/GLM all work). "mock" runs offline.
RECALLWEAVE_LLM_PROVIDER=mock
RECALLWEAVE_LLM_BASE_URL=https://api.deepseek.com/v1
RECALLWEAVE_LLM_API_KEY=
RECALLWEAVE_LLM_MODEL=deepseek-chat

# Embeddings: "hash" (deterministic, dev/test only) or "bge" (local BAAI/bge-small-zh-v1.5, 512-dim)
RECALLWEAVE_EMBEDDING_PROVIDER=hash
RECALLWEAVE_EMBEDDING_DIM=512

# Retrieval / compiler budgets (see docs/architecture.md)
RECALLWEAVE_CONTEXT_BUDGET_DEFAULT=1500
